{
  "name": "zotero-gpt",
  "type": "module",
  "version": "0.3.0",
  "description": "GPT Meet Zotero",
  "config": {
    "addonName": "Zotero GPT",
    "addonID": "zoterogpt@polygon.org",
    "addonRef": "zoterogpt",
    "addonInstance": "ZoteroGPT",
    "prefsPrefix": "extensions.zotero.zoterogpt"
  },
  "main": "src/index.ts",
  "scripts": {
    "start": "zotero-plugin serve",
    "stop": "zotero-plugin serve --stop",
    "build": "zotero-plugin build && tsc --noEmit",
    "build-dev": "cross-env NODE_ENV=development zotero-plugin build",
    "build-prod": "cross-env NODE_ENV=production zotero-plugin build",
    "tsc": "tsc --noEmit",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test --no-watch --exit-on-finish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MuiseDestiny/zotero-gpt.git"
  },
  "author": "Polygon",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "compute-cosine-similarity": "^1.0.0",
    "crypto-js": "^4.2.0",
    "markdown-it": "^13.0.1",
    "markdown-it-mathjax3": "^4.3.2",
    "punycode": "^2.3.1",
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/crypto-js": "^4.2.2",
    "@types/markdown-it": "^12.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "chai": "^5.2.0",
    "cross-env": "^7.0.3",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  }
}
